# Firebase web config — copy to .env.local (git-ignored) for local dev, and add
# the same vars in Vercel → Project → Settings → Environment Variables.
#
# These are NOT secrets — the Firebase web config is a public project identifier.
# Access is enforced by Firebase Auth + firestore.rules, not by hiding these.
#
# Find these values in: Firebase console → Project settings (gear) →
# "Your apps" → your Web app → SDK setup and configuration → Config.
#
# If these are absent, the app runs in open "local mode" (no login wall,
# localStorage only). Set them to turn on the Google login wall + cloud sync.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
