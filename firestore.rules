rules_version = '2';

// Security rules for OKC Hunters Recs.
// These are the REAL access gate — the client UI only reflects what these allow.
//
//   admins/{email}     — one doc per ADMIN (doc ID = lowercase Google email).
//                        Bootstrapped once in the Firebase console. Admins can
//                        manage the allowlist from inside the app.
//   allowlist/{email}  — one doc per allowed user (doc ID = lowercase email).
//                        Created/removed by an admin (in-app) or the console.
//   users/{uid}        — a single private doc per user holding their tracking
//                        data. Readable/writable only by that user, while
//                        their email is allowlisted (admins are always allowed).
service cloud.firestore {
  match /databases/{database}/documents {

    // Require an actual Google sign-in with a verified email.
    function isGoogleVerified() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }

    // Admins are listed in the admins collection (managed in the console).
    function isAdmin() {
      return isGoogleVerified()
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // Allowed = an admin, or an allowlisted Google-verified user.
    function isAllowed() {
      return isGoogleVerified()
        && (isAdmin()
            || exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email.lower())));
    }

    // The app only ever writes { tracking: <map>, updatedAt } to a user doc.
    function validUserDoc() {
      return request.resource.data.keys().hasOnly(['tracking', 'updatedAt'])
        && request.resource.data.tracking is map
        && request.resource.data.tracking.size() <= 300;
    }

    // Admins are bootstrapped in the console only. A signed-in user may read
    // ONLY their own admin doc (so the app can decide whether to show the panel).
    match /admins/{email} {
      allow read: if isGoogleVerified() && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    // Allowlist: an admin may read the whole list and add/remove entries;
    // a regular user may read ONLY their own entry (to learn if they're granted).
    match /allowlist/{email} {
      allow read: if isAdmin() || (isGoogleVerified() && request.auth.token.email.lower() == email);
      allow write: if isAdmin();
    }

    // Each user's private tracking doc.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid && isAllowed();
      allow write: if request.auth != null && request.auth.uid == uid && isAllowed() && validUserDoc();
    }

    // Anything not matched above is denied by default (Firestore default-deny).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
